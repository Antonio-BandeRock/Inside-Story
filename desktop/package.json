{
  "name": "inside-story-desktop",
  "version": "1.0.42",
  "private": true,
  "description": "Inside Story for Windows and Mac: the same app the phone runs, in an Electron window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "export": "node build-web.js",
    "dist": "node build-web.js && electron-builder --win nsis",
    "dist:mac": "node build-web.js && electron-builder --mac dmg",
    "pack": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "author": "Inside Story"
}
