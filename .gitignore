# generated native folders
/ios
/android

# Scratch/working files -- raw nutrition-database source data (large
# spreadsheets, zips, sqlite dumps) for the separate nutrition-database
# project, plus manual file backups made during risky edits. Not part of
# the app itself; deliberately excluded so the repo stays scoped to actual
# app code, not large unrelated data files.
ClaudeWork/

# unified-database's own real, large cached input artifact -- an
# extracted copy of the legacy 7-source raw database (120MB, derived
# from ClaudeWork's own already-excluded zipped original). Deliberately
# NOT excluding unified_foods.sqlite itself here -- that one IS meant to
# be a real, committed checkpoint of actual progress, the same way the
# app's own bundled assets/data/foods_reference.db always is, even
# though it's large and technically regenerable.
unified-database/.cache/

# The audit tool's own derived, fully-regeneratable build outputs --
# audit-data.json (a plain SQL export of unified_foods.sqlite) and
# unified-audit-built.html (that export spliced into the real,
# hand-authored unified-audit.html template). Neither carries anything
# the real, committed unified_foods.sqlite and the template itself don't
# already hold -- `node pipeline/export-audit-data.js && node
# pipeline/build-audit-tool.js` regenerates both from scratch in seconds
# whenever the tool needs republishing after a real review/apply pass.
unified-database/audit-tool/audit-data.json
unified-database/audit-tool/unified-audit-built.html

# Real, disposable scratch files this pipeline's own test runs and
# manual database-file swaps create and clean up after themselves --
# excluded defensively in case a run is ever interrupted mid-test.
unified-database/_*.sqlite
unified-database/_*.json

# Claude Code local state -- settings.local.json is personal-machine
# overrides by Claude Code's own convention, not meant to be shared/synced
# between machines; scheduled_tasks.lock is a runtime lock file, not content.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Stray tsc output dumps from earlier ad-hoc debugging
tsc_out*.txt
tsc_check*.txt
