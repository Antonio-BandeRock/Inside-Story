{
  "expo": {
    "name": "Inside Story",
    "slug": "inside-story",
    "owner": "inside-story",
    "version": "1.0.39.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hashimotosapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/4df4360a-6556-4989-8ad3-dcae28961d17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.insidestoryapp.app",
      "infoPlist": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Inside Story Share",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.insidestoryapp.app.is-share"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.insidestoryapp.app.is-share",
            "UTTypeDescription": "Inside Story Share",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "is"
              ]
            }
          }
        ]
      }
    },
    "android": {
      "package": "com.insidestoryapp.app",
      "adaptiveIcon": {
        "backgroundColor": "#244147",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_BLOOD_GLUCOSE",
        "android.permission.health.READ_MENSTRUATION",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.WRITE_HYDRATION",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "content",
              "mimeType": "*/*",
              "host": "*",
              "pathPattern": ".*\\.is"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "host": "*",
              "pathPattern": ".*\\.is"
            }
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "insidestoryapp.com",
              "pathPrefix": "/connect"
            },
            {
              "scheme": "https",
              "host": "insidestoryapp.com",
              "pathPrefix": "/import-shared"
            }
          ]
        }
      ]
    },
    "androidNavigationBar": {
      "enforceContrast": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-localization",
      "expo-font",
      "expo-navigation-bar",
      "./plugins/withWindowBackground.js",
      "./plugins/withAutofillDisabled.js",
      "./plugins/withNoCompressDb.js",
      "./plugins/withCleartextLan.js",
      [
        "expo-calendar",
        {
          "calendarPermission": "Inside Story uses your calendar to show upcoming appointments here and to add appointments you schedule in Inside Story to your calendar."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Inside Story uses your photos to let you choose a custom background image, or a photo of a meal you've made.",
          "cameraPermission": "Inside Story uses your camera to let you take a photo of a meal you've made, or of an ingredient label or price tag while scanning a product."
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Inside Story uses your microphone to let you search and add notes by speaking instead of typing.",
          "speechRecognitionPermission": "Inside Story uses speech recognition to turn what you say into text for search boxes and notes."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Inside Story uses your camera to scan a product's barcode while you're shopping."
        }
      ],
      [
        "rn-mlkit-ocr",
        {
          "ocrModels": [
            "latin"
          ],
          "ocrUseBundled": true
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#244147"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4df4360a-6556-4989-8ad3-dcae28961d17"
      }
    }
  }
}
